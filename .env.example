# Copy to .env.local and fill in. Server-side only: never expose these
# to the browser, never commit the filled file.

# YouCam API key from the YouCam console (India region:
# yce.makeupar.com). NOTE: the app's live mode does NOT read this
# variable; it takes the key from the connected YouCam connector at
# request time (see lib/youcam/credential.ts). This variable exists
# only for standalone probe scripts that build a client from env.
YOUCAM_API_KEY=

# VERIFIED 2026-10-22: India-region API host, confirmed by the live
# probe against this account's key (file ticket, presigned PUT, task
# create, status polling all returned the documented shapes; see
# lib/config.ts). The perfectcorp.com host seen in the plan was the
# other candidate and is not the verified host for this key.
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com

# Passcode that unlocks live mode (spends API units, including the
# judge reserve) for judges. Without it, visitors get replays only.
# The value is set by whoever deploys the app; it is never committed
# anywhere and never shown to the browser beyond the gate result.
JUDGE_PASSCODE=

# Live-mode spend caps, in units (defect #9: a passcode alone is
# not a spending control). Defaults: 60 per judge session, 300 in
# total across all sessions (the judge reserve itself).
LIVE_SESSION_SPEND_CAP_UNITS=
LIVE_GLOBAL_SPEND_CAP_UNITS=
